@baseUrl = http://localhost:3001
@ownerToken = REPLACE_OWNER_TOKEN
@memberToken = REPLACE_MEMBER_TOKEN
@classId = REPLACE_CLASS_ID
@memberUserId = REPLACE_MEMBER_USER_ID
@inviteCode = REPLACE_INVITE_CODE

### List my classes
GET {{baseUrl}}/classes
Authorization: Bearer {{ownerToken}}

### Create class
POST {{baseUrl}}/classes
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Physics 101",
  "description": "Week 1",
  "color": "#0f766e"
}

### Join class by invite
POST {{baseUrl}}/classes/join
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "inviteCode": "{{inviteCode}}"
}

### Get class detail
GET {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{ownerToken}}

### Update class
PATCH {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "description": "Updated description"
}

### Refresh invite code
POST {{baseUrl}}/classes/{{classId}}/invite-code
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{}

### Transfer ownership
POST {{baseUrl}}/classes/{{classId}}/transfer
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "newOwnerId": "{{memberUserId}}"
}

### List class members
GET {{baseUrl}}/classes/{{classId}}/members
Authorization: Bearer {{ownerToken}}

### Update member role
PATCH {{baseUrl}}/classes/{{classId}}/members/{{memberUserId}}
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "role": "ADMIN"
}

### Remove member
DELETE {{baseUrl}}/classes/{{classId}}/members/{{memberUserId}}
Authorization: Bearer {{ownerToken}}

### List class tasks
GET {{baseUrl}}/classes/{{classId}}/tasks
Authorization: Bearer {{ownerToken}}

### Create class task
POST {{baseUrl}}/classes/{{classId}}/tasks
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "title": "Task 1",
  "description": "Solve chapter 1",
  "dueAt": "2026-12-31T12:00:00.000Z"
}

### Delete class
DELETE {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{ownerToken}}
