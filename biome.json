{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"apps/**",
			"packages/**",
			"!**/node_modules",
			"!**/.next",
			"!**/dist",
			"!**/*.css",
			"!**/*.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noStaticElementInteractions": "warn",
				"useKeyWithClickEvents": "warn",
				"useSemanticElements": "warn",
				"useButtonType": "warn",
				"noLabelWithoutControl": "warn",
				"useFocusableInteractive": "warn",
				"noSvgWithoutTitle": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noDocumentCookie": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"performance": {
				"noImgElement": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/**"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			},
			"linter": {
				"rules": {
					"suspicious": {
						"noUnknownAtRules": "off"
					}
				},
				"domains": {
					"next": "recommended",
					"react": "recommended"
				}
			}
		}
	]
}
