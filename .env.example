# Backend server
LISTEN_ADDR=0.0.0.0:3001
ADMIN_TOKEN=change-me-use-a-long-random-string
SYSTEM_CONFIG_SECRET=change-me-use-a-long-random-string
JWT_SECRET=change-me-use-a-long-random-string

# Database
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow"

# S3-compatible storage
# For local dev with MinIO, use the MINIO_* vars below.
# For production with Cloudflare R2, AWS S3, etc., use the S3_* vars.
# S3_* takes precedence over MINIO_* when both are set.

# --- Local MinIO (dev) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=taskflow
MINIO_SECRET_KEY=taskflow123
MINIO_BUCKET=taskflow-files

# --- Production S3 (uncomment and fill for production) ---
# S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<access-key>
# S3_SECRET_KEY=<secret-key>
# S3_BUCKET=taskflow-files
# S3_USE_SSL=true         # default: true when S3_PORT is unset
# S3_REGION=auto           # "auto" for R2, region code for AWS
# S3_PATH_STYLE=true       # true for R2/MinIO, false for AWS virtual-hosted

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins allowed by the API (in addition to localhost)
# CORS_ORIGINS=https://taskflow.yourdomain.com

# Optional runtime controls
NOTIFICATION_WORKER_ENABLED=false

# Frontend runtime wiring
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
