# ─── Backend server ─────────────────────────────────────────────────────────
LISTEN_ADDR=0.0.0.0:3001
ADMIN_TOKEN=change-me-use-a-long-random-string
SYSTEM_CONFIG_SECRET=change-me-use-a-long-random-string

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow"

# ─── S3-compatible storage ─────────────────────────────────────────────────
# For local dev with MinIO, use the MINIO_* vars below.
# For production with Cloudflare R2, AWS S3, etc., use the S3_* vars.
# S3_* takes precedence over MINIO_* when both are set.

# --- Local MinIO (dev) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=taskflow
MINIO_SECRET_KEY=taskflow123
MINIO_BUCKET=taskflow-files

# --- Production S3 (uncomment and fill for production) ---
# S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<access-key>
# S3_SECRET_KEY=<secret-key>
# S3_BUCKET=taskflow-files
# S3_USE_SSL=true         # default: true when S3_PORT is unset
# S3_REGION=auto           # "auto" for R2, region code for AWS
# S3_PATH_STYLE=true       # true for R2/MinIO, false for AWS virtual-hosted

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins allowed by the API (in addition to localhost)
# CORS_ORIGINS=https://taskflow.yourdomain.com

# ─── Auth cookies ──────────────────────────────────────────────────────────
# For production subdomains (app.example.com + api.example.com), set:
# COOKIE_DOMAIN=.example.com
# Set true when API is served over HTTPS.
# COOKIE_SECURE=true

# ─── Workers ───────────────────────────────────────────────────────────────
NOTIFICATION_WORKER_ENABLED=false

# ─── Observability ─────────────────────────────────────────────────────────
# pino log level. trace|debug|info|warn|error. Default: info.
LOG_LEVEL=info

# Axiom log sink. When both AXIOM_TOKEN and AXIOM_DATASET are set, structured
# logs ship to Axiom via the @axiomhq/pino transport (runs in a worker thread,
# does not write to local disk). Leave blank for local development — logs are
# pretty-printed to the terminal via pino-pretty instead.
# AXIOM_TOKEN=xaat-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AXIOM_DATASET=taskflow-api

# Prisma slow query threshold in milliseconds. Default: 200.
SLOW_QUERY_MS=200

# If true, prisma slow query logs include the raw parameter array. Off by
# default because parameters may contain user data.
LOG_PRISMA_PARAMS=false

# ─── CAPTCHA (Cap.js) ─────────────────────────────────────────────────────
# Set CAP_ENABLED=true to require CAPTCHA on registration and email change.
# CAP_ENABLED=true
# CAP_URL=https://cap.example.com/<site-key>
# CAP_SECRET=your-cap-site-secret-key

# ─── Dev seed (optional) ──────────────────────────────────────────────────
# Populate admin system config (LLM, STT) when running `pnpm seed`.
# These are written into the system_config DB table, not used at runtime.
# DEV_SEED_LLM_PROVIDER=openai
# DEV_SEED_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
# DEV_SEED_LLM_MODEL=openai/gpt-4o-mini
# DEV_SEED_LLM_API_KEY=your-gateway-api-key
# DEV_SEED_STT_API_KEY=your-assemblyai-api-key

# ─── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# NEXT_PUBLIC_CAP_API_ENDPOINT=https://cap.example.com/<site-key>/
# Optional global analytics/RUM snippet injected via next/script in root layout.
# Paste raw JavaScript (or a full <script>...</script> block).
# INSTRUMENTATION_SNIPPET=window.NREUM=window.NREUM||{};NREUM.init={...};
