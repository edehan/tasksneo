# ─── Test environment ──────────────────────────────────────────────────────
LISTEN_ADDR=0.0.0.0:3001
ADMIN_TOKEN=test-admin-token
SYSTEM_CONFIG_SECRET=test-system-config-secret

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow_test"

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3-compatible storage (MinIO) ─────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=taskflow
MINIO_SECRET_KEY=taskflow123
MINIO_BUCKET=taskflow-test-files

# ─── Workers ───────────────────────────────────────────────────────────────
NOTIFICATION_WORKER_ENABLED=false
