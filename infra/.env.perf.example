# Copy this file to infra/.env.perf and fill the host/secrets before running:
# docker compose --env-file infra/.env.perf -f infra/docker-compose.perf.yml up -d --build

COMPOSE_PROJECT_NAME=taskflow_perf

# Public service URLs baked into the web image and used by CORS.
# Replace 127.0.0.1 with the test server IP/domain before remote testing.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:3000

# Host bind settings. Keep 0.0.0.0 for direct access from the load generator.
WEB_BIND_ADDR=0.0.0.0
WEB_PORT=3000
API_BIND_ADDR=0.0.0.0
API_PORT=3001
MINIO_BIND_ADDR=0.0.0.0
MINIO_CONSOLE_BIND_ADDR=127.0.0.1
MINIO_CONSOLE_PORT=9001

# Secrets. Generate real values for infra/.env.perf:
# openssl rand -hex 32
ADMIN_TOKEN=change-me-use-openssl-rand-hex-32
SYSTEM_CONFIG_SECRET=change-me-use-openssl-rand-hex-32

# PostgreSQL.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-16
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=5GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_WORK_MEM=16MB

# Redis/Valkey. This caps Redis data, not the container's total memory.
REDIS_MAXMEMORY=768mb

# Local MinIO for S3-compatible file flows.
# Important: S3_ENDPOINT is embedded in presigned URLs and is also used by the
# API container. Use a hostname, not 127.0.0.1. Docker resolves this hostname to
# the MinIO container through a network alias; your browser/load generator must
# resolve it to the test server IP through DNS or /etc/hosts.
S3_ENDPOINT=minio.perf.local
S3_PORT=9000
S3_ACCESS_KEY=taskflow
S3_SECRET_KEY=taskflow123
S3_BUCKET=taskflow-perf
S3_USE_SSL=false
S3_REGION=auto
S3_PATH_STYLE=true
MINIO_ROOT_USER=taskflow
MINIO_ROOT_PASSWORD=taskflow123

# Auth cookies. Keep false for plain HTTP performance test hosts.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CAPTCHA. Disabled for local performance tests unless explicitly needed.
CAP_ENABLED=false
CAP_URL=
CAP_SECRET=
NEXT_PUBLIC_CAP_API_ENDPOINT=

# Background workers and logging.
NOTIFICATION_WORKER_ENABLED=true
LOG_LEVEL=info
SLOW_QUERY_MS=200
LOG_PRISMA_PARAMS=false
AXIOM_TOKEN=
AXIOM_DATASET=

# Optional RUM/analytics script URLs injected into the web app build.
INSTRUMENTATION_SCRIPT_URLS=

# Seed script defaults. Run through the Compose seed profile after services are healthy.
SEED_BASE_URL=http://api:3001
SEED_COUNT=100
SEED_CONCURRENCY=10
SEED_EMAIL_DOMAIN=example.com
SEED_PASSWORD=12345678
SEED_NICKNAME_PREFIX=Random User
SEED_CLASS_PREFIX=Random Class
SEED_CLASS_DESCRIPTION=Created for performance testing
SEED_TIMEZONE=Asia/Shanghai
