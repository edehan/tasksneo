# ─── Server ──────────────────────────────────────────────────────────────────
LISTEN_ADDR=0.0.0.0:3001
ADMIN_TOKEN=change-me-use-openssl-rand-hex-32
SYSTEM_CONFIG_SECRET=change-me-use-openssl-rand-hex-32

# ─── Database (docker internal network) ─────────────────────────────────────
# Must match POSTGRES_USER and POSTGRES_PASSWORD in docker-compose.prod.yml
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://taskflow:change-me-strong-password@postgres:5432/taskflow

# ─── Redis (docker internal network) ────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── S3-compatible storage (external) ───────────────────────────────────────
# Cloudflare R2 example:
S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2-access-key>
S3_SECRET_KEY=<r2-secret-key>
S3_BUCKET=taskflow-files
S3_USE_SSL=true
S3_REGION=auto
S3_PATH_STYLE=true
# S3_PORT is omitted — uses default 443 for HTTPS

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend domain(s), comma-separated
CORS_ORIGINS=https://taskflow.yourdomain.com

# ─── Auth cookies ───────────────────────────────────────────────────────────
# For production subdomains (app.example.com + api.example.com), set:
# COOKIE_DOMAIN=.example.com
# Set true when API is served over HTTPS.
# COOKIE_SECURE=true

# ─── CAPTCHA (Cloudflare Turnstile) ─────────────────────────────────────────
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# ─── Workers ─────────────────────────────────────────────────────────────────
NOTIFICATION_WORKER_ENABLED=true

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# AXIOM_TOKEN=xaat-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AXIOM_DATASET=taskflow-api

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.taskflow.yourdomain.com
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>
# Optional analytics/RUM script URLs injected via next/script in root layout.
# Comma-separated list. Supports local (/instrumentation/rum.js) or remote URLs.
# INSTRUMENTATION_SCRIPT_URLS=/instrumentation/rum.js,https://cdn.example.com/analytics.js
