{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "bash scripts/dev-up.sh",
    "dev:infra": "bash scripts/dev-infra.sh",
    "dev:api": "bash scripts/dev-api.sh",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:landing": "pnpm --filter landing dev",
    "dev:seed": "pnpm --filter @taskflow/api seed:dev",
    "dev:down": "bash scripts/dev-down.sh",
    "lint": "biome check .",
    "typecheck": "pnpm --filter @taskflow/db exec prisma generate && pnpm --filter @taskflow/api exec tsc --noEmit",
    "test": "pnpm --filter @taskflow/api test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "effect": ">=3.20.0",
      "picomatch": ">=4.0.4",
      "fast-xml-parser": ">=5.5.7"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "turbo": "^2.8.17"
  }
}
